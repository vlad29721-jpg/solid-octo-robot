DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY

# Если DATABASE_URL указывает на Postgres Supabase, примените supabase/00_schema.sql
# и supabase/01_demo.sql в SQL Editor. Для Realtime включите publication для таблиц.
# Никогда не используйте NEXT_PUBLIC_ для DEEPSEEK_API_KEY или service_role ключа.
